{
  "name": "ManPharma 04 - Conversion & Upsell",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "purchase",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "node-webhook-purchase",
      "name": "Purchase Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-560, 0],
      "webhookId": "manpharma-purchase"
    },
    {
      "parameters": {
        "jsCode": "// Accept a purchase event from Graphy webhook OR a manual mark-paid form.\nconst b = $json.body || $json;\nconst contact = String(b.contact || b.phone || b.whatsapp || b.email || b.chat_id || '');\nconst channel = (b.channel || (b.email ? 'email' : 'whatsapp')).toLowerCase();\nreturn [{ json: {\n  contact,\n  channel,\n  name: b.name || 'Student',\n  amount: b.amount || '69',\n  product: b.product || 'Pharmaceutics Notes',\n  status: 'Customer',\n  stage: 5,\n  last_message_at: new Date().toISOString().slice(0, 10),\n  next_action_at: ''\n} }];"
      },
      "id": "node-normalize",
      "name": "Normalize Purchase",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-340, 0]
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": { "__rl": true, "value": "YOUR_SHEET_ID", "mode": "id" },
        "sheetName": { "__rl": true, "value": "Leads", "mode": "name" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "contact": "={{ $json.contact }}",
            "status": "Customer",
            "stage": "5",
            "last_message_at": "={{ $json.last_message_at }}",
            "next_action_at": "",
            "notes": "Paid - upsell sent"
          },
          "matchingColumns": ["contact"]
        },
        "options": {}
      },
      "id": "node-update",
      "name": "Mark Customer (stops drip)",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.4,
      "position": [-120, 0],
      "continueOnFail": true
    },
    {
      "parameters": {
        "rules": {
          "values": [
            { "conditions": { "options": { "caseSensitive": false, "typeValidation": "loose" }, "conditions": [ { "leftValue": "={{ $('Normalize Purchase').item.json.channel }}", "rightValue": "telegram", "operator": { "type": "string", "operation": "equals" } } ], "combinator": "and" }, "outputKey": "telegram" },
            { "conditions": { "options": { "caseSensitive": false, "typeValidation": "loose" }, "conditions": [ { "leftValue": "={{ $('Normalize Purchase').item.json.channel }}", "rightValue": "whatsapp", "operator": { "type": "string", "operation": "equals" } } ], "combinator": "and" }, "outputKey": "whatsapp" },
            { "conditions": { "options": { "caseSensitive": false, "typeValidation": "loose" }, "conditions": [ { "leftValue": "={{ $('Normalize Purchase').item.json.channel }}", "rightValue": "email", "operator": { "type": "string", "operation": "equals" } } ], "combinator": "and" }, "outputKey": "email" }
          ]
        },
        "options": {}
      },
      "id": "node-switch-channel",
      "name": "Route By Channel",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [120, 0]
    },
    {
      "parameters": {
        "chatId": "={{ $('Normalize Purchase').item.json.contact }}",
        "text": "🎉 Thank you {{ $('Normalize Purchase').item.json.name }}! Payment mil gayi — notes ab account me available hain.\n\n📈 Ek aur subject? Combo me bachat 👉 https://ramannaiknaware.graphy.com/courses/DPharm-1st-Year-Combo-1777537319930-69f311273e897b00ec94531a\n\n🎁 Doston ko refer karo: https://ramannaiknaware.graphy.com/courses/DPharm-1st-year-Pharmaceutics-Complete-Notes-69883bcbc8266f1243b25fed\n\nAll the best! 💪",
        "additionalFields": {}
