      "id": "node-read",
      "name": "Read Leads",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.4,
      "position": [-340, 0]
    },
    {
      "parameters": {
        "jsCode": "// Keep only leads that are due today and still in the funnel, then build the next message.\nconst today = new Date().toISOString().slice(0, 10);\nconst CHECKOUT = 'https://ramannaiknaware.graphy.com/courses/DPharm-1st-year-Pharmaceutics-Complete-Notes-69883bcbc8266f1243b25fed';\nconst COMBO = 'https://ramannaiknaware.graphy.com/courses/DPharm-1st-Year-Combo-1777537319930-69f311273e897b00ec94531a';\nconst SAMPLE = 'https://drive.google.com/file/d/1rHrKPCAWHzfMvzjK2drLs-l34tzHswcT/view?usp=sharing';\n\n// stage -> { text, daysToNext } ; stage 0 welcome already sent at capture, so start at 1.\nfunction msgFor(stage, name) {\n  const n = name || 'Student';\n  switch (Number(stage)) {\n    case 1: return { text: `${n}, ek quick tip 📚\\nPharmaceutics me Dosage Forms, Sterile Formulations aur Packaging har exam me aate hain. Hamari notes me ready answers + diagrams hain.\\nSample: ${SAMPLE}`, days: 1 };\n    case 2: return { text: `${n}, 500+ students in notes se padh rahe hain ⭐ \\\"Score 20 marks badh gaya\\\" — common feedback.\\n🔥 Early-bird ₹69 (first 30 students), phir ₹99.\\nLock karo 👉 ${CHECKOUT}`, days: 2 };\n    case 3: return { text: `${n}, notes lene chahiye? ✅ MSBTE ER20 chapters ✅ Diagrams+Hinglish ✅ Lifetime access ✅ Sirf ₹69.\\nSecure payment 👉 ${CHECKOUT}`, days: 2 };\n    case 4: return { text: `⏳ ${n}, last reminder! Early-bird ₹69 khatam hone wala hai, phir ₹99.\\nCombo me zyada bachat 👉 ${COMBO}\\nSingle 👉 ${CHECKOUT}`, days: 0 };\n    default: return null; // stage >= 5 -> done\n  }\n}\n\nconst out = [];\nfor (const item of $input.all()) {\n  const r = item.json;\n  const status = String(r.status || '').toLowerCase();\n  if (!(status === 'new' || status === 'nurturing')) continue;\n  if (r.next_action_at && String(r.next_action_at) > today) continue;\n  const nextStage = Number(r.stage || 0) + 1;\n  const m = msgFor(nextStage, r.name);\n  if (!m) {\n    // funnel finished -> mark Lost (no buy) and stop\n    out.push({ json: { ...r, _send: false, status: 'Lost', stage: nextStage, last_message_at: today, next_action_at: '', message: '' } });\n    continue;\n  }\n  const next = m.days > 0 ? new Date(Date.now() + m.days * 86400000).toISOString().slice(0, 10) : '';\n  out.push({ json: { ...r, _send: true, message: m.text, status: 'Nurturing', stage: nextStage, last_message_at: today, next_action_at: next } });\n}\nreturn out;"
      },
