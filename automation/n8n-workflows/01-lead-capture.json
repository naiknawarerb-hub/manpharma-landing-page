      "id": "node-telegram-trigger",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [-560, 220]
    },
    {
      "parameters": {
        "jsCode": "// Normalize incoming lead from website webhook OR telegram trigger into one shape.\nconst out = [];\nfor (const item of $input.all()) {\n  const b = item.json.body || item.json; // webhook puts form data under body\n  let lead;\n  if (item.json.message) {\n    // Telegram trigger\n    const m = item.json.message;\n    lead = {\n      name: (m.from && (m.from.first_name || m.from.username)) || 'Student',\n      channel: 'telegram',\n      contact: String(m.chat.id),\n      subject_interest: 'Pharmaceutics',\n      source: 'telegram',\n      raw_text: m.text || ''\n    };\n  } else {\n    lead = {\n      name: b.name || 'Student',\n      channel: (b.channel || (b.email ? 'email' : 'whatsapp')).toLowerCase(),\n      contact: String(b.contact || b.whatsapp || b.phone || b.email || ''),\n      subject_interest: b.subject_interest || b.subject || 'Pharmaceutics',\n      source: b.source || 'landing_page',\n      raw_text: ''\n    };\n  }\n  lead.lead_id = 'LEAD-' + Date.now().toString().slice(-8);\n  lead.status = 'New';\n  lead.stage = 0;\n  const today = new Date().toISOString().slice(0, 10);\n  const tomorrow = new Date(Date.now() + 86400000).toISOString().slice(0, 10);\n  lead.date_added = today;\n  lead.last_message_at = today;\n  lead.next_action_at = tomorrow;\n  lead.notes = 'Auto-captured';\n  out.push({ json: lead });\n}\nreturn out;"
      },
      "id": "node-normalize",
      "name": "Normalize Lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-320, 100]
    },
    {
      "parameters": {
        "operation": "lookup",
        "documentId": { "__rl": true, "value": "YOUR_SHEET_ID", "mode": "id" },
        "sheetName": { "__rl": true, "value": "Leads", "mode": "name" },
        "lookupColumn": "contact",
        "lookupValue": "={{ $json.contact }}",
        "options": {}
      },
      "id": "node-lookup",
      "name": "Find Existing Lead",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.4,
      "position": [-100, 100],
