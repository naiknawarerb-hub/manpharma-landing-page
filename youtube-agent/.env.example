# ── Anthropic Claude (required for real AI generation) ─────────────────────
# Get a key at https://console.anthropic.com/. Without it the agent still runs,
# falling back to deterministic templates so you can try the whole pipeline.
ANTHROPIC_API_KEY=

# Model used by all agents. Keep the latest capable Claude model.
CLAUDE_MODEL=claude-opus-4-8

# ── Channel identity ───────────────────────────────────────────────────────
CHANNEL_NAME=My Channel
CHANNEL_NICHE=AI tools for creators
TARGET_AUDIENCE=solo creators and small teams
CONTENT_TONE=energetic, practical, no fluff

# ── Server ─────────────────────────────────────────────────────────────────
PORT=3456

# Optional shared secret. If set, all mutating endpoints (/api/generate, etc.)
# require an `x-api-key: <this value>` header.
API_KEY=

# ── Scheduler ──────────────────────────────────────────────────────────────
# Set to "false" to disable the built-in cron jobs (useful in dev).
ENABLE_SCHEDULER=true
# Cron expression for the daily content batch (default 06:00 every day).
DAILY_CRON=0 6 * * *
# How many content ideas to generate per daily batch.
DAILY_IDEA_COUNT=3
